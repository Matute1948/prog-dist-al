<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="post-unit" transaction-type="RESOURCE_LOCAL">
        <!--<class>org.example.</class> -->
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver" />
            <property name="jakarta.persistence.jdbc.url"    value="jdbc:postgresql://127.0.0.1:5432/postgres" />
            <property name="jakarta.persistence.jdbc.user"   value="postgres" />
            <property name="jakarta.persistence.jdbc.password" value="labcom,2015" />
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create" />
            <property name="jakarte.persistence.sql-load-source" value="import.sql"/>
            <property name="jakarta.persistence.schema-generation.scripts.action" value="create"/>
            <property name="jakarta.persistence.schema-generation.scripts.create-target" value="posts-ddl.sql"/>
        </properties>
    </persistence-unit>
</persistence>